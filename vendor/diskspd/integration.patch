diff --git a/Common/Common.h b/Common/Common.h
index bde10c1..61d42f3 100644
--- a/Common/Common.h
+++ b/Common/Common.h
@@ -51,7 +51,24 @@ SOFTWARE.
 #include "ThroughputMeter.h"
 #include "Version.h"
 
-using namespace std;
+using namespace std;
+
+// XML text nodes must escape paths containing characters such as '&'.
+inline string EscapeXmlText(const string& value)
+{
+    string result;
+    for (char ch : value)
+    {
+        switch (ch)
+        {
+        case '&': result += "&amp;"; break;
+        case '<': result += "&lt;"; break;
+        case '>': result += "&gt;"; break;
+        default: result += ch; break;
+        }
+    }
+    return result;
+}
 
 TRACELOGGING_DECLARE_PROVIDER(g_hEtwProvider);
 
